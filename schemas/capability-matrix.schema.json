{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentCapabilityMatrix",
  "type": "object",
  "required": ["version", "project", "generated_at", "capabilities"],
  "properties": {
    "version": {"type": "string"}, "project": {"type": "string"}, "generated_at": {"type": "string"},
    "capabilities": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["capability", "current_status", "target_status", "priority", "dependencies", "implementation_files", "verification", "evidence"], "properties": {
      "capability": {"type": "string"}, "current_status": {"enum": ["absent", "partial", "implemented", "verified", "not_applicable"]},
      "target_status": {"enum": ["absent", "partial", "implemented", "verified", "not_applicable"]}, "priority": {"pattern": "^P([0-9]|10)$"},
      "dependencies": {"type": "array", "items": {"type": "string"}}, "implementation_files": {"type": "array", "items": {"type": "string"}},
      "risk": {"type": "string"}, "verification": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}
    }}}
  }
}
