{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-agent-engineering/deployment-plan.schema.json",
  "title": "DeploymentPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "blueprint_id", "engagement", "installation_allowed", "deployment_allowed",
    "dependencies", "credential_policy", "approval_gates", "validation_commands", "migration",
    "cutover", "rollback", "recipe_hash"
  ],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "blueprint_id": {"type": "string", "minLength": 1},
    "engagement": {"enum": ["plan_only", "guided_install", "end_to_end"]},
    "installation_allowed": {"const": false},
    "deployment_allowed": {"const": false},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "credential_policy": {"const": "secret_refs_only"},
    "approval_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "migration": {
      "type": "object", "additionalProperties": false, "required": ["required", "strategy"],
      "properties": {"required": {"type": "boolean"}, "strategy": {"type": "string", "minLength": 1}}
    },
    "cutover": {
      "type": "object", "additionalProperties": false, "required": ["requires_human_approval", "automatic"],
      "properties": {"requires_human_approval": {"const": true}, "automatic": {"const": false}}
    },
    "rollback": {
      "type": "object", "additionalProperties": false, "required": ["required", "verified_before_cutover"],
      "properties": {"required": {"const": true}, "verified_before_cutover": {"const": true}}
    },
    "recipe_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
