{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runId",
    "tenantId",
    "userId",
    "sessionId",
    "agentId",
    "objective",
    "plan",
    "currentStep",
    "messages",
    "observations",
    "artifacts",
    "workspace",
    "modelProfile",
    "stepCount",
    "maxSteps",
    "tokenUsage",
    "status",
    "errors",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "channelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "currentStep": {
      "type": "integer",
      "minimum": 0
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "enabledTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabledSkills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabledMcpServers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace": {
      "type": "string"
    },
    "modelProfile": {
      "type": "string"
    },
    "stepCount": {
      "type": "integer",
      "minimum": 0
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1,
      "description": "Positive count in the minimal executable templates. Existing runtimes may use another compatible versioned contract for count-unbounded execution with deadline/cancel/no-progress enforcement."
    },
    "tokenUsage": {
      "type": "object",
      "required": [
        "input",
        "output",
        "total"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "estimatedCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "created",
        "planning",
        "running",
        "waiting_approval",
        "verifying",
        "completed",
        "failed",
        "cancelled",
        "waiting_input",
        "pause_requested",
        "paused",
        "resuming",
        "cancel_requested",
        "partial"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "configurationFingerprint": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "controlRequestId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "dependencies",
        "requiredTools",
        "requiredSkills",
        "status",
        "verificationMethod"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "skipped"
          ]
        },
        "verificationMethod": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Versioned host Runtime contract; optional control states/epoch/sequence do not imply the bundled minimal runtime implements durable pause, input or streaming."
}
