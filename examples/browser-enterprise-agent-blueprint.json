{
  "version": "1.0",
  "blueprint_id": "browser-enterprise-agent.v1",
  "agent": {"id": "browser-enterprise-agent", "name": "Browser Enterprise Agent", "owner": "enterprise-platform"},
  "product": {
    "objective": "Operate a bounded enterprise workflow through an authenticated browser control plane",
    "intended_users": ["authorized operators", "auditors"],
    "business_workflow": ["receive request", "plan bounded work", "request approvals", "produce evidence", "verify result"],
    "deliverables": ["verified response", "run timeline", "audit artifacts"],
    "non_goals": ["unattended production release", "browser-side Agent execution"],
    "prohibited_uses": ["privilege escalation", "cross-tenant access", "unapproved external writes"],
    "acceptance_criteria": ["all browser projections are scope filtered", "approval replay is parameter bound", "completion maps to deterministic evidence"]
  },
  "perception": {
    "modalities": ["text", "file", "history", "external_event"],
    "intent_fields": ["objective", "constraints"],
    "entity_fields": ["request_id", "workspace_id"],
    "sources": ["authenticated browser session", "authorized project files"]
  },
  "data_governance": {
    "data_classes": ["internal", "confidential"],
    "tenant_isolation": true,
    "workspace_boundary": "one authorized tenant workspace per run",
    "retention_days": 90,
    "residency": "deployment policy",
    "consent_required": true,
    "compliance_constraints": ["auditable access", "export and deletion"]
  },
  "capabilities": {
    "required": ["runtime", "planner", "tools", "permissions", "verification", "security", "evaluation", "session", "checkpoint", "memory", "observability"],
    "optional": ["mcp", "subagents", "model-routing"]
  },
  "autonomy": {
    "level": "supervised",
    "allowed_actions": ["read authorized inputs", "produce candidate artifacts", "propose memory"],
    "approval_required_actions": ["external_write", "production_change", "production_release", "sensitive_data_access"],
    "always_denied_actions": ["self_grant_permissions", "embed_credentials", "cross_tenant_access"],
    "escalation_owner": "enterprise-operator"
  },
  "service": {
    "max_steps": 32,
    "max_tokens": 100000,
    "max_cost_usd": 10.0,
    "deadline_seconds": 1800,
    "latency_slo_ms": 30000,
    "availability_target": 0.995,
    "quality_threshold": 0.95,
    "recovery_target": "resume from the latest verified checkpoint"
  },
  "implementation": {
    "language": "python",
    "profile": "production",
    "deployment_environment": "customer-managed enterprise environment",
    "optional_integrations": {"channels": "none", "model_provider": "configured", "mcp": "none"}
  },
  "experience": {
    "profile": "operations_console",
    "reference_stack": "react_fastapi",
    "auth": "server_session",
    "realtime": "sse",
    "surfaces": ["overview", "conversation", "run_inspector", "approvals", "artifacts", "memory", "audit", "settings"]
  },
  "memory": {
    "enabled": true,
    "profile": "enterprise",
    "canonical_store": "postgresql",
    "keyword_index": "postgres_fts",
    "vector_index": "pgvector",
    "graph_store": "none",
    "framework": "native"
  },
  "delivery": {"engagement": "end_to_end"},
  "verification": {
    "mandatory_scenarios": ["browser login and logout", "cross-tenant denial", "approval rejection", "SSE reconnect", "memory correction and deletion", "verification failure"],
    "deterministic_assertions": ["API never executes Agent work inline", "browser receives safe event projections only", "no prohibited action executes", "completion has evidence"],
    "eval_thresholds": {"task_success": 0.95, "safety_violation_rate": 0.0},
    "security_gates": ["session and CSRF policy", "tenant isolation", "secret redaction", "artifact authorization"],
    "verifier_type": "deterministic"
  },
  "assumptions": [{"id": "a1", "statement": "Infrastructure credentials are supplied later through approved SecretRefs", "risk": "low", "resolution": "assumed"}],
  "unknowns": []
}
